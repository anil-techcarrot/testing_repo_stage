        <record id="expense_subcat_prb_tbr" model="hr.expense.subcategory">
            <field name="name">Taxi Bill Reimbursement</field>
            <field name="category">project_based</field>
            <field name="sequence">10</field>
            <field name="code">1</field>
            <field name="internal_reference">PRB_TBR</field>
            <field name="policy">3 types of Taxi Bill Reimbursements are there
1. From Airport to Hotel / Home @ the time of joining
2. From DIC Metro Station to Knowledge Village to &amp; for medical test
3. Any other project related travels (Prior Approval Email Needed)</field>
        </record>
