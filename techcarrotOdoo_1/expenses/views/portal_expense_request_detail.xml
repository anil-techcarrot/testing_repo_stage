<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_expense_request_detail" name="ESS - Expense Claim Request Detail">
        <t t-call="portal.portal_layout">
            <div class="o_portal container my-4">

                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/my/ess"><i class="fa fa-tachometer"/> Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="/my/expenses">Expense Claim Requests</a></li>
                        <li class="breadcrumb-item active"><t t-esc="expense_request.name"/></li>
                    </ol>
                </nav>

                <t t-if="error">
                    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <t t-if="error_msg"><t t-esc="error_msg"/></t>
                        <t t-else="">Action failed.</t>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"/>
                    </div>
                </t>

                <div class="row align-items-center mb-4">
                    <div class="col-md-8">
                        <h2 class="mb-1"><i class="fa fa-money text-warning me-2"/><t t-esc="expense_request.name"/></h2>
                        <span t-attf-class="badge badge-{{
                            'success' if expense_request.state in ('approved', 'paid') else
                            'danger' if expense_request.state in ('rejected', 'cancelled') else
                            'warning' if expense_request.state == 'submitted' else
                            'secondary'
                        }} fs-6">
                            <t t-esc="dict(expense_request._fields['state'].selection).get(expense_request.state)"/>
                        </span>
                        <t t-if="expense_request.state == 'submitted'">
                            <span class="text-muted ms-2">Pending with: <t t-esc="expense_request.approval_stage_label"/></span>
                        </t>
                    </div>
                    <div class="col-md-4 text-end">
                        <a href="/my/expenses" class="btn btn-outline-secondary btn-sm"><i class="fa fa-list"/> All Requests</a>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-3"><strong>Employee</strong><br/><t t-esc="expense_request.employee_id.name"/></div>
                            <div class="col-md-3"><strong>Expense Category</strong><br/>
                                <t t-esc="dict(expense_request._fields['expense_category'].selection).get(expense_request.expense_category)"/>
                            </div>
                            <div class="col-md-3"><strong>Sub Category</strong><br/><t t-esc="expense_request.subcategory_id.name"/></div>
                            <div class="col-md-3"><strong>Currency</strong><br/><t t-esc="expense_request.currency_code"/></div>

                            <t t-if="expense_request.expense_category == 'project_based'">
                                <div class="col-md-3"><strong>Project</strong><br/><t t-esc="expense_request.project_name or '—'"/></div>
                                <div class="col-md-3"><strong>Project Manager</strong><br/><t t-esc="expense_request.project_manager_id.name or '—'"/></div>
                                <div class="col-md-3"><strong>Line Manager</strong><br/><t t-esc="expense_request.line_manager_id.name or '—'"/></div>
                            </t>

                            <t t-if="expense_request.policy">
                                <div class="col-12">
                                    <strong>Policy</strong>
                                    <div class="form-control bg-light" style="white-space:pre-line;"><t t-esc="expense_request.policy"/></div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-transparent"><strong>Expense Details</strong></div>
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead style="background:#1F3B1F; color:#fff;">
                                <tr>
                                    <th>Description</th><th>Expense Date</th><th>Unit No</th>
                                    <th>Unit Amount</th><th>Expense</th><th>Attachment</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="expense_request.line_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="line.description"/></td>
                                        <td><t t-esc="line.expense_date"/></td>
                                        <td><t t-esc="line.unit_no"/></td>
                                        <td><t t-esc="'%.2f' % line.unit_amount"/></td>
                                        <td><t t-esc="'%.2f' % line.expense_amount"/></td>
                                        <td>
                                            <t t-if="line.attachment_id">
                                                <a t-attf-href="/web/content/#{line.attachment_id.id}?download=true" target="_blank">
                                                    <t t-esc="line.attachment_id.name"/>
                                                </a>
                                            </t>
                                            <t t-else="">—</t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="4" class="text-end">Total Expense Amount</td>
                                    <td colspan="2"><t t-esc="'%.2f' % expense_request.total_amount"/> <t t-esc="expense_request.currency_code"/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <t t-if="expense_request.comments">
                        <div class="card-body pt-0">
                            <strong>Comments</strong>
                            <div class="form-control bg-light"><t t-esc="expense_request.comments"/></div>
                        </div>
                    </t>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-transparent"><strong>Approval Trail</strong></div>
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead style="background:#1F3B1F; color:#fff;">
                                <tr><th>Role</th><th>Date and Time</th><th>Action Taker</th><th>Action Type</th><th>Comments</th></tr>
                            </thead>
                            <tbody>
                                <t t-if="not expense_request.approval_ids">
                                    <tr><td colspan="5" class="text-center text-muted py-3">Not yet submitted.</td></tr>
                                </t>
                                <t t-foreach="expense_request.approval_ids" t-as="ap">
                                    <tr>
                                        <td><t t-esc="ap.role"/></td>
                                        <td><t t-esc="ap.action_date.strftime('%m/%d/%Y %I:%M %p') if ap.action_date else ''"/></td>
                                        <td><t t-esc="ap.action_taker_id.name"/></td>
                                        <td><t t-esc="dict(ap._fields['action_type'].selection).get(ap.action_type)"/></td>
                                        <td><t t-esc="ap.comments or '-'"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <t t-if="is_approver">
                    <div class="card border-0 shadow-sm mb-4 border-start border-4 border-warning">
                        <div class="card-body">
                            <h5 class="mb-3"><i class="fa fa-gavel me-2"/>Action Required — <t t-esc="expense_request.approval_stage_label"/> Review</h5>
                            <form t-attf-action="/my/expenses/#{expense_request.id}/approve" method="POST" class="mb-2 d-inline">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="text" name="comment" class="form-control d-inline-block mb-2" style="max-width:400px;" placeholder="Comment (optional)"/>
                                <br/>
                                <button type="submit" class="btn btn-success me-2"><i class="fa fa-check me-1"/> Approve</button>
                            </form>
                            <form t-attf-action="/my/expenses/#{expense_request.id}/reject" method="POST" class="d-inline">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-danger"><i class="fa fa-times me-1"/> Reject</button>
                            </form>
                        </div>
                    </div>
                </t>

                <t t-if="can_mark_paid">
                    <div class="card border-0 shadow-sm mb-4 border-start border-4 border-success">
                        <div class="card-body">
                            <h5 class="mb-3"><i class="fa fa-money me-2"/>Fully Approved</h5>
                            <form t-attf-action="/my/expenses/#{expense_request.id}/mark-paid" method="POST" class="d-flex align-items-end gap-2 flex-wrap">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div>
                                    <label class="form-label fw-bold mb-1">Pay From (Journal) <span class="text-danger">*</span></label>
                                    <select name="journal_id" class="form-select" required="required" style="min-width:220px;">
                                        <option value="">-- Select Bank/Cash Journal --</option>
                                        <t t-foreach="payment_journals" t-as="jr">
                                            <option t-att-value="jr.id"><t t-esc="jr.name"/> (<t t-esc="jr.type"/>)</option>
                                        </t>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-success"><i class="fa fa-check-circle me-1"/> Mark as Paid &amp; Post Payment</button>
                            </form>
                            <small class="text-muted d-block mt-2">
                                This creates and posts an Accounting Payment for
                                <t t-esc="'%.2f' % expense_request.total_amount"/> <t t-esc="expense_request.currency_code"/>,
                                which deducts from the selected journal and appears in its Journal Entries.
                            </small>
                        </div>
                    </div>
                </t>

                <t t-if="expense_request.state == 'paid' and expense_request.payment_id">
                    <div class="card border-0 shadow-sm mb-4 border-start border-4 border-success">
                        <div class="card-body">
                            <h5 class="mb-3"><i class="fa fa-bank me-2"/>Payment Posted</h5>
                            <div class="row g-3">
                                <div class="col-md-3"><strong>Payment Ref</strong><br/><t t-esc="expense_request.payment_id.name"/></div>
                                <div class="col-md-3"><strong>Journal</strong><br/><t t-esc="expense_request.payment_journal_id.name"/></div>
                                <div class="col-md-3"><strong>Journal Entry</strong><br/><t t-esc="expense_request.payment_move_id.name or '-'"/></div>
                                <div class="col-md-3"><strong>Payment Status</strong><br/>
                                    <span class="badge badge-success"><t t-esc="expense_request.payment_state"/></span>
                                </div>
                            </div>
                            <t t-if="request.env.user.has_group('base.group_user')">
                                <a t-attf-href="/odoo/accounting" target="_blank" class="btn btn-outline-secondary btn-sm mt-3">
                                    <i class="fa fa-external-link me-1"/> Open in Accounting
                                </a>
                            </t>
                        </div>
                    </div>
                </t>

            </div>
        </t>
    </template>
</odoo>
