<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= LIST VIEW ================= -->
    <record id="view_hr_expense_request_tree" model="ir.ui.view">
        <field name="name">hr.expense.request.tree</field>
        <field name="model">hr.expense.request</field>
        <field name="arch" type="xml">
            <list string="Expense Claim Requests" decoration-warning="state=='submitted'"
                  decoration-success="state in ('approved','paid')"
                  decoration-danger="state in ('rejected','cancelled')"
                  decoration-muted="state=='draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="expense_category"/>
                <field name="subcategory_id"/>
                <field name="total_amount" sum="Total"/>
                <field name="currency_code"/>
                <field name="submitted_date"/>
                <field name="approval_stage_label" string="Pending With"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('approved','paid')"
                       decoration-warning="state=='submitted'"
                       decoration-danger="state in ('rejected','cancelled')"/>
            </list>
        </field>
    </record>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_hr_expense_request_form" model="ir.ui.view">
        <field name="name">hr.expense.request.form</field>
        <field name="model">hr.expense.request</field>
        <field name="arch" type="xml">
            <form string="Expense Claim Request">
                <header>
                    <button name="%(action_hr_expense_approval_wizard)d" type="action" string="Approve / Reject"
                            class="btn-primary" invisible="state != 'submitted'"
                            context="{'default_request_id': id}"/>
                    <button name="%(action_hr_expense_mark_paid_wizard)d" type="action" string="Mark as Paid"
                            class="btn-primary" invisible="state != 'approved'"
                            context="{'default_request_id': id}"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft','submitted')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'submitted' or not approval_stage_label">
                        <strong>Pending With:</strong> <field name="approval_stage_label" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="emp_code" readonly="1"/>
                            <field name="expense_category" readonly="1"/>
                            <field name="subcategory_id" readonly="1"/>
                            <field name="currency_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="project_id" readonly="1" invisible="expense_category != 'project_based'"/>
                            <field name="project_manager_id" readonly="1" invisible="expense_category != 'project_based'"/>
                            <field name="line_manager_id" readonly="1" invisible="expense_category != 'project_based'"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="submitted_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Policy" invisible="not policy">
                        <field name="policy" nolabel="1" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Expense Lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="description"/>
                                    <field name="expense_date"/>
                                    <field name="unit_no"/>
                                    <field name="unit_amount"/>
                                    <field name="expense_amount" sum="Total"/>
                                    <field name="attachment_id"/>
                                </list>
                            </field>
                            <field name="comments" readonly="1"/>
                        </page>
                        <page string="Approval Trail">
                            <field name="approval_ids" readonly="1">
                                <list>
                                    <field name="role"/>
                                    <field name="action_date"/>
                                    <field name="action_taker_id"/>
                                    <field name="action_type" widget="badge"
                                           decoration-success="action_type in ('approved','paid')"
                                           decoration-danger="action_type=='rejected'"/>
                                    <field name="comments" string="Reason / Comments"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payment" invisible="state != 'paid'">
                            <group>
                                <field name="payment_id" readonly="1"/>
                                <field name="payment_journal_id" readonly="1"/>
                                <field name="payment_move_id" readonly="1"/>
                                <field name="payment_state" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= SEARCH VIEW ================= -->
    <!-- ================= ACTIONS ================= -->
    <record id="action_hr_expense_request_all" model="ir.actions.act_window">
        <field name="name">Expense Claim Requests</field>
        <field name="res_model">hr.expense.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No expense claim requests yet.</p>
        </field>
    </record>

    <!-- ================= SUB CATEGORY (config) ================= -->
    <record id="view_hr_expense_subcategory_tree" model="ir.ui.view">
        <field name="name">hr.expense.subcategory.tree</field>
        <field name="model">hr.expense.subcategory</field>
        <field name="arch" type="xml">
            <list string="Expense Sub Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="code"/>
                <field name="internal_reference"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_expense_subcategory_form" model="ir.ui.view">
        <field name="name">hr.expense.subcategory.form</field>
        <field name="model">hr.expense.subcategory</field>
        <field name="arch" type="xml">
            <form string="Expense Sub Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="code"/>
                        <field name="internal_reference"/>
                        <field name="active"/>
                    </group>
                    <group string="Policy">
                        <field name="policy" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_expense_subcategory" model="ir.actions.act_window">
        <field name="name">Expense Sub Categories</field>
        <field name="res_model">hr.expense.subcategory</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= MENUS ================= -->
    <menuitem id="menu_expense_claims_root" name="Expense Claims" sequence="65"/>
    <menuitem id="menu_expense_claims_requests" name="Requests" parent="menu_expense_claims_root"
              action="action_hr_expense_request_all" sequence="10"/>
    <menuitem id="menu_expense_claims_config" name="Configuration" parent="menu_expense_claims_root" sequence="90"/>
    <menuitem id="menu_expense_claims_subcategories" name="Sub Categories" parent="menu_expense_claims_config"
              action="action_hr_expense_subcategory" sequence="10"/>

</odoo>