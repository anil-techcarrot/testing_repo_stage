<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_expense_approval_wizard_form" model="ir.ui.view">
        <field name="name">hr.expense.approval.wizard.form</field>
        <field name="model">hr.expense.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve / Reject Expense Claim">
                <field name="request_id" invisible="1"/>
                <group>
                    <field name="approval_stage_label" readonly="1"/>
                    <field name="comment" placeholder="Add a comment or reason — the employee will see this on their claim."/>
                </group>
                <footer>
                    <button name="action_confirm_approve" type="object" string="Approve" class="btn-primary"/>
                    <button name="action_confirm_reject" type="object" string="Reject" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_expense_approval_wizard" model="ir.actions.act_window">
        <field name="name">Approve / Reject Expense Claim</field>
        <field name="res_model">hr.expense.approval.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_hr_expense_mark_paid_wizard_form" model="ir.ui.view">
        <field name="name">hr.expense.mark.paid.wizard.form</field>
        <field name="model">hr.expense.mark.paid.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark Expense Claim as Paid">
                <field name="request_id" invisible="1"/>
                <group>
                    <field name="total_amount"/>
                    <field name="journal_id"/>
                </group>
                <footer>
                    <button name="action_confirm_mark_paid" type="object" string="Mark as Paid &amp; Post Payment" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_expense_mark_paid_wizard" model="ir.actions.act_window">
        <field name="name">Mark Expense Claim as Paid</field>
        <field name="res_model">hr.expense.mark.paid.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
