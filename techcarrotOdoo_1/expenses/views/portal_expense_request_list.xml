<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_expense_requests" name="ESS - My Expense Claim Requests">
        <t t-call="portal.portal_layout">
            <div class="o_portal container my-4">

                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/my/ess"><i class="fa fa-tachometer"/> Dashboard</a>
                        </li>
                        <li class="breadcrumb-item active">Expense Claim Requests</li>
                    </ol>
                </nav>

                <div class="row align-items-center mb-4">
                    <div class="col-md-8">
                        <h2 class="mb-1"><i class="fa fa-money text-warning me-2"/>My Expense Claim Requests</h2>
                    </div>
                    <div class="col-md-4 text-end">
                        <a href="/my/ess/expenses/new" class="btn btn-sm text-white fw-bold"
                           style="background:linear-gradient(135deg,#2D6A4F,#E8450A);border:none;">
                            <i class="fa fa-plus me-1"/> Create New
                        </a>
                    </div>
                </div>

                <div class="mb-3">
                    <t t-foreach="searchbar_filters" t-as="key">
                        <a t-attf-href="/my/expenses?filterby=#{key}"
                           t-attf-class="btn btn-sm me-1 #{'btn-success' if filterby == key else 'btn-outline-secondary'}">
                            <t t-esc="searchbar_filters[key]['label']"/>
                        </a>
                    </t>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead style="background:#1F3B1F; color:#fff;">
                            <tr>
                                <th>Reference #</th>
                                <th>Expense Sub Category</th>
                                <th>Total Amount</th>
                                <th>Last Modified</th>
                                <th>Pending With</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="not expense_requests">
                                <tr><td colspan="6" class="text-center text-muted py-4">No expense claim requests yet.</td></tr>
                            </t>
                            <t t-foreach="expense_requests" t-as="er">
                                <tr style="cursor:pointer;" t-attf-onclick="window.location='/my/expenses/#{er.id}'">
                                    <td><a t-attf-href="/my/expenses/#{er.id}"><t t-esc="er.name"/></a></td>
                                    <td><t t-esc="er.subcategory_id.name"/></td>
                                    <td><t t-esc="'%.2f' % er.total_amount"/> <t t-esc="er.currency_code"/></td>
                                    <td><t t-esc="er.write_date.strftime('%m/%d/%Y %I:%M %p') if er.write_date else ''"/></td>
                                    <td>
                                        <t t-if="er.state == 'submitted'"><t t-esc="er.approval_stage_label"/></t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td>
                                        <span t-attf-class="badge badge-{{
                                            'success' if er.state in ('approved', 'paid') else
                                            'danger' if er.state in ('rejected', 'cancelled') else
                                            'warning' if er.state == 'submitted' else
                                            'secondary'
                                        }}">
                                            <t t-esc="dict(er._fields['state'].selection).get(er.state)"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>
