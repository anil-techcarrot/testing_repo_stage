<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_line_tree_opening_closing" model="ir.ui.view">
        <field name="name">account.move.line.list.opening.closing</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="balance" position="after">
                <field name="x_opening_balance" optional="show" sum="Opening"/>
                <field name="x_closing_balance" optional="show" sum="Closing"/>
            </field>
        </field>
    </record>

</odoo>