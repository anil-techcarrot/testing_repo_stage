<odoo>
    <record id="view_form16_bulk_import_wizard" model="ir.ui.view">
        <field name="name">form16.bulk.import.wizard.form</field>
        <field name="model">form16.bulk.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="zip_file" filename="zip_filename"/>
                    <field name="zip_filename" invisible="1"/>
                </group>
                <field name="log" invisible="not log"/>
                <footer>
                    <button name="action_import" string="Import" type="object"
                            class="btn-primary" invisible="log"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_form16_bulk_import" model="ir.actions.act_window">
        <field name="name">Bulk Import Form 16</field>
        <field name="res_model">form16.bulk.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_form16_bulk_import"
              name="Bulk Import Form 16"
              parent="hr.menu_human_resources_configuration"
              groups="hr.group_hr_manager"
              action="action_form16_bulk_import"
              sequence="1"/>
</odoo>
