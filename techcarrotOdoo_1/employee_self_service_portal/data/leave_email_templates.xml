            <field name="body_html"><![CDATA[
                <div style="font-family: Arial, sans-serif; padding: 20px; max-width: 600px;">
                    <div style="background-color: #7a3010; padding: 15px; border-radius: 5px;">
                        <h2 style="color: white; margin: 0;">Leave Cancelled</h2>
                    </div>
