        <!-- HR cancel (backend Refuse): goes to the full apply-recipient list -->
        <record id="email_template_leave_cancelled_hr" model="mail.template">
            <field name="name">Leave Cancelled (HR) - Notification</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="subject">Leave Cancelled: {{ object.employee_id.name }} - {{ object.holiday_status_id.name }} [{{ object.request_date_from.strftime('%d-%m-%Y') if object.request_date_from else '' }}] (Ref #{{ object.id }})</field>
